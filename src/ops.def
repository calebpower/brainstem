/* ops.def — THE op table. One line per op, and the only place an op exists.
 *
 * OP(code, NAME, handler, reqlen, replen)
 *
 *   code     the wire opcode. 0x00 is permanently invalid, so the commonest
 *            brainfuck defect -- emitting a cell you forgot to fill -- fails
 *            loudly on the first byte instead of being read as a valid call.
 *   NAME     the enum suffix, and the name in diagnostics
 *   handler  the function, or NULL for an op that is declared and not built
 *   reqlen   exact request payload length, or BS_VAR when a tail follows
 *   replen   exact reply payload length, or BS_VAR
 *
 * Included three times by ops.c: once for the prototypes, once for the table,
 * once for the name lookup. Nothing else includes it.
 *
 * A row with handler NULL is an op the ABI declares and this broker has not
 * built. It answers NOSUCHOP, which is RECOVERABLE: every frame is length
 * prefixed, so the broker consumes the payload and carries on. That is the
 * forward compatibility path for a program written against a later minor
 * version, and making it fatal would destroy it.
 *
 * The arities come from ABI.md section 7 and are checked FROM THIS TABLE by
 * the dispatcher, before the handler runs. Nineteen of the twenty three have
 * an exact request length, and that is the anti desync mechanism: the
 * realistic catastrophic failure of this protocol is not deadlock but a
 * program that under reads a reply and shifts every frame after it. Strict
 * length validation turns that into a loud failure within a frame or two.
 */

/* ---- ctl: the only family that does not cross the platform seam --------- */
OP(0x01, HELLO,        op_ctl_hello,  10,     BS_VAR)
OP(0x02, EXIT,         op_ctl_exit,    1,     0)

/* ---- time -------------------------------------------------------------- */
OP(0x03, CLOCK_NOW,    op_time_clock_now, 1,   12)

/* ---- rand -------------------------------------------------------------- */
OP(0x04, RANDOM_BYTES, op_rand_bytes,  2,     BS_VAR)

/* ---- net --------------------------------------------------------------- */
OP(0x05, SOCKET,       op_net_socket,  3,     4)
OP(0x06, CONNECT,      op_net_connect,38,     0)
OP(0x07, BIND,         op_net_bind,   38,     32)
OP(0x08, LISTEN,       op_net_listen,  6,     0)
OP(0x09, ACCEPT,       op_net_accept,  6,     36)

/* ---- io: files, pipes and sockets alike -------------------------------- */
OP(0x0A, READ,         op_io_read,     8,     BS_VAR)
OP(0x0B, WRITE,        op_io_write, BS_VAR,   2)
OP(0x0C, CLOSE,        op_io_close,    4,     0)
OP(0x0D, POLL,         op_io_poll,  BS_VAR,   BS_VAR)

/* ---- proc: what makes one program able to drive another ---------------- */
OP(0x0E, PIPE,         op_proc_pipe,   2,     8)
OP(0x0F, SPAWN,        op_proc_spawn,BS_VAR,  4)
OP(0x10, WAIT,         op_proc_wait,   6,     4)

/* ---- fs ---------------------------------------------------------------- */
OP(0x11, OPEN,         op_fs_open,  BS_VAR,   4)
OP(0x12, SEEK,         op_fs_seek,    13,     8)
OP(0x13, STAT,         op_fs_stat,  BS_VAR,   32)
OP(0x14, READDIR,      op_fs_readdir,  6,     BS_VAR)
OP(0x15, UNLINK,       op_fs_unlink,BS_VAR,   0)
OP(0x16, MKDIR,        op_fs_mkdir, BS_VAR,   0)
OP(0x17, RENAME,       op_fs_rename,BS_VAR,   0)
